<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="qlvetau-pu" transaction-type="RESOURCE_LOCAL">
        <class>com.trainstation.model.BangGia</class>
        <class>com.trainstation.model.HoaDon</class>
        <class>com.trainstation.model.ChiTietHoaDon</class>
        <class>com.trainstation.model.ChiTietHoaDonId</class>
        <class>com.trainstation.model.KhachHang</class>
        <class>com.trainstation.model.NhanVien</class>
        <class>com.trainstation.model.Ga</class>
        <class>com.trainstation.model.DauMay</class>
        <class>com.trainstation.model.TaiKhoan</class>
        <class>com.trainstation.model.ChuyenTau</class>
        <class>com.trainstation.model.Ve</class>
        <class>com.trainstation.model.ChangTau</class>
        <class>com.trainstation.model.ChiTietChuyenTau</class>
        <class>com.trainstation.model.ChiTietChuyenTauId</class>
        <class>com.trainstation.model.Ghe</class>
        <class>com.trainstation.model.LoaiGhe</class>
        <class>com.trainstation.model.LoaiNV</class>
        <class>com.trainstation.model.LoaiVe</class>
        <class>com.trainstation.model.ToaTau</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/qltauhoa"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="sapassword"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
